# ============================================================================
# SPIL MAX — Environment Configuration (.env.example)
# Copy to `.env` before running `docker compose up -d --build`
# ============================================================================

# Public HTTP port exposed by the Nginx frontend container
APP_PORT=8080

# Allowed CORS origins for backend API (comma-separated in production, e.g. https://elearning.spil.co.id)
CORS_ORIGIN=*

# Optional override when running backend directly outside Docker:
# PORT=4000
# DATABASE_PATH=./storage/spil-max.sqlite
# UPLOAD_DIR=./storage/uploads
